generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum ProductCategory {
  BOOK
  MERCHANDISE
  APPAREL
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductSizeLabel {
  SMALL
  MEDIUM
  LARGE
}

enum OutOfStockBehavior {
  HIDE
  SHOW_AS_OUT_OF_STOCK
  ALLOW_BACKORDER
}

enum AuthorStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum InquiryType {
  GENERAL
  PUBLISH_WITH_US
  ORDER_SUPPORT
  PRODUCT
}

enum InquiryStatus {
  NEW
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum TrackingStatus {
  NOT_DISPATCHED
  DISPATCHED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  phone        String?
  role         UserRole       @default(CUSTOMER)
  status       UserStatus     @default(ACTIVE)
  addresses    Address[]
  orders       Order[]
  cart         Cart?
  refreshTokens RefreshToken[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  phone       String
  line1       String
  line2       String?
  city        String
  state       String
  postalCode  String
  country     String   @default("India")
  isDefault   Boolean  @default(false)
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

model Product {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  category           ProductCategory
  sku                String             @unique
  brand              String?
  status             ProductStatus      @default(DRAFT)
  price              Decimal            @db.Decimal(10, 2)
  salePrice          Decimal?           @db.Decimal(10, 2)
  tax                Decimal            @default(0) @db.Decimal(5, 2)
  trackStock         Boolean            @default(true)
  globalStock        Int                @default(0)
  lowStockThreshold  Int                @default(5)
  outOfStockBehavior OutOfStockBehavior @default(SHOW_AS_OUT_OF_STOCK)
  primaryImage       String?
  galleryImages      String[]           @default([])
  sizes              ProductSize[]
  book               Book?
  orderItems         OrderItem[]
  cartItems          CartItem[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([category])
  @@index([status])
  @@map("products")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String            @id @default(cuid())
  cartId    String
  cart      Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeLabel ProductSizeLabel?
  quantity  Int               @default(1)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([cartId, productId, sizeLabel])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}


model ProductSize {
  id        String           @id @default(cuid())
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     ProductSizeLabel
  stock     Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([productId, label])
  @@index([label])
  @@map("product_sizes")
}

model Author {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  shortBio  String?
  fullBio   String?
  status    AuthorStatus @default(DRAFT)
  avatarUrl String?
  books     Book[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status])
  @@map("authors")
}

model Book {
  id               String    @id @default(cuid())
  title            String
  slug             String    @unique
  genre            String?
  publicationDate  DateTime?
  shortDescription String?
  fullDescription  String?
  coverUrl         String?
  qrEnabled        Boolean   @default(false)
  qrSongTitle      String?
  qrSongUrl        String?
  authorId         String
  author           Author    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  productId        String    @unique
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([authorId])
  @@index([publicationDate])
  @@map("books")
}

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  addressId        String
  address          Address       @relation(fields: [addressId], references: [id], onDelete: Restrict)
  items            OrderItem[]
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(PENDING)
  payments         Payment[]
  razorpayOrderId  String?       @unique
  tracking         TrackingInfo?
  subtotal         Decimal       @db.Decimal(10, 2)
  taxTotal         Decimal       @default(0) @db.Decimal(10, 2)
  shippingTotal    Decimal       @default(0) @db.Decimal(10, 2)
  discountTotal    Decimal       @default(0) @db.Decimal(10, 2)
  total            Decimal       @db.Decimal(10, 2)
  placedAt         DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId])
  @@index([addressId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          String            @id @default(cuid())
  orderId     String
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  sizeLabel   ProductSizeLabel?
  productName String
  sku         String
  quantity    Int
  unitPrice   Decimal           @db.Decimal(10, 2)
  taxAmount   Decimal           @default(0) @db.Decimal(10, 2)
  total       Decimal           @db.Decimal(10, 2)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Inquiry {
  id        String        @id @default(cuid())
  type      InquiryType   @default(GENERAL)
  status    InquiryStatus @default(NEW)
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  metadata  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([type])
  @@index([status])
  @@map("inquiries")
}

model StoreSettings {
  id              String   @id @default(cuid())
  storeName       String   @default("VINVERSE")
  supportEmail    String?
  supportPhone    String?
  currency        String   @default("INR")
  taxEnabled      Boolean  @default(true)
  defaultTaxRate  Decimal  @default(0) @db.Decimal(5, 2)
  shippingEnabled Boolean  @default(true)
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("store_settings")
}

model TrackingInfo {
  id             String         @id @default(cuid())
  orderId        String         @unique
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status         TrackingStatus @default(NOT_DISPATCHED)
  carrier        String?
  trackingNumber String?
  trackingUrl    String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@map("tracking_info")
}

model Payment {
  id                  String        @id @default(cuid())
  orderId             String
  order               Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  razorpayOrderId     String        @unique
  razorpayPaymentId   String?
  razorpaySignature   String?
  provider            String        @default("razorpay")
  amount              Int           // in paise (smallest currency unit)
  currency            String        @default("INR")
  verified            Boolean       @default(false)
  verifiedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([orderId])
  @@map("payments")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?  // null for system events
  action      String   // e.g. PRODUCT_CREATE, ORDER_STATUS_CHANGE
  entityType  String   // e.g. Product, Order, Book
  entityId    String
  metadata    Json?    // additional context (no secrets)
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}
