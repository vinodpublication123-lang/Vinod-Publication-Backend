                "exec": [
                  "pm.test('bookSlug was generated', function() { pm.expect(pm.environment.get('bookSlug'), 'bookSlug not set — run 0.SETUP first').to.be.ok; });",
                  "pm.test('Status 20x', function() { pm.expect(pm.response.code).to.be.oneOf([200,201,204]); });",
