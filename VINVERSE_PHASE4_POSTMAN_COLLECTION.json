              "raw": "{\n  \"fullName\": \"Test Customer\",\n  \"phone\": \"9876543210\",\n  \"line1\": \"123 Test Street\",\n  \"city\": \"Chennai\",\n  \"state\": \"Tamil Nadu\",\n  \"postalCode\": \"600001\",\n  \"country\": \"India\",\n  \"isDefault\": true\n}",
              "options": {
