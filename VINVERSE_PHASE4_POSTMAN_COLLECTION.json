                  "pm.test('adminAccessToken captured', function() { pm.expect(d.accessToken).to.be.a('string').and.not.empty; });",
                  "pm.test('auditActorId captured', function() { pm.expect(d.user.id).to.be.a('string').and.not.empty; });"
                ]
